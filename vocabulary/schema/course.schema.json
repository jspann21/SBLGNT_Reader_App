{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GNT Reader vocabulary list",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "id", "name", "levelLabel", "levels"],
  "properties": {
    "$schema": {"type": "string"},
    "version": {"const": 1},
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "not": {"enum": ["user", "proper"]}
    },
    "name": {"type": "string", "minLength": 1, "maxLength": 100},
    "levelLabel": {"type": "string", "minLength": 1, "maxLength": 30},
    "levels": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"pattern": "^(?:[1-9][0-9]{0,2}|1000)$"},
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {"type": "string", "minLength": 1, "maxLength": 100}
      }
    }
  }
}
